
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isUserAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function getUserAccessLevel() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nivelAcceso;
    }

    function levelToNumber(level) {
      let levels = {
        'Público': 1, 'Departamental': 2, 'Jerárquico': 3, 'Ejecutivo': 4, 'Confidencial': 5
      };
      return levels[level];
    }

    function hasAccess(requiredLevel) {
      if (!isUserAuthenticated()) { return false; }
      return levelToNumber(getUserAccessLevel()) >= levelToNumber(requiredLevel);
    }
    
    // Security Rules for Collections

    match /users/{userId} {
      allow read: if request.auth.uid == userId || hasAccess('Jerárquico');
      allow list: if hasAccess('Jerárquico');
      allow create: if isUserAuthenticated();
      allow update, delete: if hasAccess('Administrador');
    }

    match /procesos/{processId} {
      allow read: if resource.data.clasificacion == 'Público' ||
                   (resource.data.clasificacion == 'Privado' && hasAccess('Departamental')) ||
                   (resource.data.clasificacion == 'Confidencial' && hasAccess('Confidencial'));
      allow list: if hasAccess('Público'); // Relies on client-side filtered queries
      allow create, update, delete: if hasAccess('Consultor');
    }

    match /politicas/{politicaId} {
      allow read: if resource.data.clasificacion == 'Público' ||
                   (resource.data.clasificacion == 'Privado' && hasAccess('Departamental')) ||
                   (resource.data.clasificacion == 'Confidencial' && hasAccess('Confidencial'));
      allow list: if hasAccess('Público'); // Relies on client-side filtered queries
      allow create, update, delete: if hasAccess('Gerente de Proyecto');
    }
    
    match /excepciones/{exceptionId} {
      allow read, list, create, update, delete: if hasAccess('Jerárquico');
    }
    
    match /areas/{areaId} {
      allow read, list: if hasAccess('Público');
      allow create, update, delete: if hasAccess('Administrador');
    }
    
    match /departamentos/{deptoId} {
      allow read, list: if hasAccess('Público');
      allow create, update, delete: if hasAccess('Administrador');
    }
    
    match /puestos/{puestoId} {
      allow read, list: if hasAccess('Público');
      allow create, update, delete: if hasAccess('Administrador');
    }
    
    match /sistemas/{sistemaId} {
      allow read, list: if hasAccess('Público');
      allow create, update, delete: if hasAccess('Administrador');
    }
    
    match /sistemas_costos/{costoId} {
      allow read, list: if hasAccess('Público');
      allow create, update, delete: if hasAccess('Administrador');
    }

    match /procedimientos/{procId} {
      allow read, list: if hasAccess('Público');
      allow create, update, delete: if hasAccess('Consultor');
    }
    
    match /actividades/{actId} {
      allow read, list: if hasAccess('Público');
      allow create, update, delete: if hasAccess('Consultor');
    }
    
    match /acciones/{accionId} {
      allow read, list: if hasAccess('Usuario Final');
      allow create, update, delete: if hasAccess('Consultor');
    }
  }
}
