
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated.
    function isUserAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get the user's access level from their profile.
    function getUserAccessLevel(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.nivelAcceso;
    }

    // Helper function to check if the user is an administrator by role.
    function isUserRoleAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'Administrador';
    }

    // USERS collection rules
    match /users/{userId} {
      allow read: if isUserAuthenticated();
      allow write: if isUserRoleAdmin() || request.auth.uid == userId;
    }

    // Configuration collections (Areas, Departamentos, Puestos, etc.)
    match /areas/{areaId} {
      allow read: if isUserAuthenticated();
      allow write: if isUserRoleAdmin();
    }
    match /departamentos/{deptoId} {
      allow read: if isUserAuthenticated();
      allow write: if isUserRoleAdmin();
    }
    match /puestos/{puestoId} {
      allow read: if isUserAuthenticated();
      allow write: if isUserRoleAdmin();
    }

    // Systems and Costs
    match /sistemas/{sistemaId} {
      allow read: if isUserAuthenticated();
      allow write: if isUserRoleAdmin();
    }
    match /sistemas_costos/{costoId} {
      allow read: if isUserAuthenticated();
      allow write: if isUserRoleAdmin();
    }
    
    // Core operational data
    match /acciones/{accionId} {
      allow read, write: if isUserAuthenticated();
    }
    match /actividades/{actividadId} {
      allow read, write: if isUserAuthenticated();
    }
    match /procedimientos/{procedimientoId} {
      allow read, write: if isUserAuthenticated();
    }

    // PROCESOS collection rules
    match /procesos/{procesoId} {
      allow read: if isUserAuthenticated(); // Further filtering done client-side for now
      allow write: if isUserAuthenticated(); // Allow writes, can be refined later based on roles
    }

    // POLITICAS collection rules
    match /politicas/{politicaId} {
      // A user can read a policy if:
      // 1. The policy is 'Público'.
      // 2. The policy is 'Privado' and their access level is 'Departamental' or higher.
      // 3. The policy is 'Confidencial' and their access level is 'Confidencial'.
      allow read: if isUserAuthenticated() &&
                  (resource.data.clasificacion == 'Público' ||
                  (resource.data.clasificacion == 'Privado' && getUserAccessLevel(request.auth.uid) in ['Departamental', 'Jerárquico', 'Ejecutivo', 'Confidencial']) ||
                  (resource.data.clasificacion == 'Confidencial' && getUserAccessLevel(request.auth.uid) == 'Confidencial'));

      // A user can list (query) policies if their query only asks for classifications they are allowed to see.
      allow list: if isUserAuthenticated() &&
                   request.query.wheres[0].field == 'clasificacion' &&
                   request.query.wheres[0].op == 'in' &&
                   (
                     (getUserAccessLevel(request.auth.uid) == 'Público' && request.query.wheres[0].value.hasOnly(['Público'])) ||
                     (getUserAccessLevel(request.auth.uid) in ['Departamental', 'Jerárquico', 'Ejecutivo'] && request.query.wheres[0].value.hasOnly(['Público', 'Privado'])) ||
                     (getUserAccessLevel(request.auth.uid) == 'Confidencial') // Admin can query all
                   );
                   
      allow write: if isUserRoleAdmin();
    }

    // Exceptions collection rules
    match /excepciones/{excepcionId} {
       allow read, write: if isUserAuthenticated();
    }
  }
}
