
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // --- Helper Functions ---
    
    function esAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'Administrador';
    }
    
    function nivelAccesoUsuario() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userData.nivelAcceso;
    }

    // --- Collection Rules ---

    // USERS: Users can read/update their own profile. Admins can manage all.
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId || esAdmin();
      allow create, delete: if esAdmin();
    }

    // CONFIGURATION: Only Admins can write, authenticated users can read.
    match /areas/{areaId} {
      allow read: if request.auth.uid != null;
      allow create, update, delete: if esAdmin();
    }
    
    match /departamentos/{deptoId} {
      allow read: if request.auth.uid != null;
      allow create, update, delete: if esAdmin();
    }

    match /puestos/{puestoId} {
      allow read: if request.auth.uid != null;
      allow create, update, delete: if esAdmin();
    }
    
    match /sistemas/{sistemaId} {
      allow read: if request.auth.uid != null;
      allow create, update, delete: if esAdmin();
    }
    
    match /sistemas_costos/{costoId} {
      allow read, write: if esAdmin();
    }

    // OPERATIONAL: Authenticated users can read/write.
    // Specific access is controlled by application logic and permissions context.
    match /acciones/{accionId} {
      allow read, write: if request.auth.uid != null;
    }
    
    match /actividades/{actividadId} {
      allow read, write: if request.auth.uid != null;
    }
    
    match /procedimientos/{procedimientoId} {
      allow read, write: if request.auth.uid != null;
    }

    // --- Granular Access Control for Processes and Policies ---

    function puedeVerDocumento(clasificacion) {
      let nivel = nivelAccesoUsuario();
      if (esAdmin()) { return true; }
      if (clasificacion == 'Público') { return true; }
      if (clasificacion == 'Privado') {
        return nivel in ['Departamental', 'Jerárquico', 'Ejecutivo', 'Confidencial'];
      }
      if (clasificacion == 'Confidencial') {
        return nivel == 'Confidencial';
      }
      return false;
    }

    match /procesos/{procesoId} {
      allow get: if puedeVerDocumento(resource.data.clasificacion);
      allow list: if puedeVerDocumento(resource.data.clasificacion); // Firestore queries check this on each document
      allow create, update, delete: if request.auth.uid != null; // Write permissions controlled by app logic
    }
    
    match /politicas/{politicaId} {
      allow get: if puedeVerDocumento(resource.data.clasificacion);
      allow list: if puedeVerDocumento(resource.data.clasificacion);
      allow create, update: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol in ['Administrador', 'Gerente de Proyecto', 'Consultor'];
      allow delete: if esAdmin();
    }
  }
}
